#####################################################################
# SAMPLE CONFIGURATION FILE FOR DASHUSB Pi Setup
#
# Example config file for DashUSB setup. Lines with "#" are comments/ignored.
# Remove the "#" before "export" to activate a line. Be sure to rename this file
# to "dashusb.conf" and place it in the "boot" folder of your SD card.
# More info: https://github.com/Sentry-Six/Dash-USB
#
######################################################################

# Wifi setup information.
# You do not need to set these variables if networking is already configured.
# Note that some devices only support 2.4 GHz wifi.
#export SSID='your_ssid'
#export WIFIPASS='your_pass'

# Variables for CIFS (Windows/Mac file sharing) archiving.
# If you want to use rsync, rclone, or NFS, delete or comment out this section
# and uncomment the rsync or rclone section below.
export ARCHIVE_SYSTEM=cifs
export ARCHIVE_SERVER=your_archive_name_or_ip
export SHARE_NAME='your_archive_share/optional_path_on_share'
export SHARE_USER=username
export SHARE_PASSWORD='password'
# the cifs options below usually don't need to be specified
# export SHARE_DOMAIN=domain
# export CIFS_VERSION="3.0"

# Variables for rsync archiving
# For instructions setting up SSH Public Key authentication, view:
# https://github.com/Sentry-Six/Dash-USB/wiki/Archive-Methods
#export ARCHIVE_SYSTEM=rsync
#export RSYNC_USER=username
#export RSYNC_SERVER=hostname_or_ip
#export RSYNC_PATH=path_on_server

# Variables for rclone archiving
# If you are using rclone to archive to a local (non-cloud) server,
# you may want to set the ARCHIVE_SERVER variable to the name or
# ip of you local server instead.
#export ARCHIVE_SYSTEM=rclone
#export ARCHIVE_SERVER=8.8.8.8
#export RCLONE_DRIVE="remotename"
#export RCLONE_PATH="remotepathname"
# The following is optional
#export RCLONE_FLAGS=()

# Variables for NFS archiving
# Note: SHARE_NAME must be the exact export path on the NAS (e.g. /volume1/DashUSB)
#export ARCHIVE_SYSTEM=nfs
#export ARCHIVE_SERVER=hostname_or_ip
#export SHARE_NAME='/volume1/DashUSB'

# The DATA_DRIVE option (formerly USB_DRIVE) is used to specify that you want
# to store recordings on a different drive than the boot drive. If you don't
# plan on using an sd card at all (i.e. you are both booting from and storing
# recordings on the USB drive), or are ONLY using an sd card (i.e. boot from
# and store recordings on sd card), do NOT uncommment this line.
# This should be set to the device name of the drive, e.g. /dev/sda for a drive
# connected to a USB port, or /dev/nvme0n1 for an onboard NVME drive.
# NOTE: the specified drive will be wiped and repartitioned.
# export DATA_DRIVE=/dev/sda

# GM's firmware hard-deletes recordings older than about 2 hours,
# regardless of drive size. Dash USB defeats that limit by snapshotting
# the drive on a timer and archiving the snapshots — the default
# interval comes from the vehicle profile (900 s, giving ~8 capture
# chances per segment inside the 2 h window). Lower it if you want a
# smaller worst-case capture gap; raising it above ~half the rolling
# window risks losing footage.
# export SNAPSHOT_INTERVAL=900 # this number is in seconds

# Everything the car records is archived by default — the rolling
# delete makes the archive the only durable copy. Uncomment to keep
# local snapshots only (they still rotate as space runs out).
#export ARCHIVE_RECORDINGS=false

# Vehicle profile. Selects the brand-specific recording layout the
# capture pipeline expects. Currently available: gm_surroundvision.
# export VEHICLE_PROFILE=gm_surroundvision

# Notes on sd card and image sizes:
#   * A 256 GB or larger high-endurance sd card (or USB/NVMe drive) is
#     recommended — GM records ~5 GB per hour of driving, all of which
#     Dash USB retains in snapshots until space runs out.
#   * The setup script will keep a fixed 6 GB of space in reserve regardless of
#     sd card size.
#   * CAM_SIZE must be at least 64G: the car checks for a drive of 64 GB
#     or larger with 32 GB available before it will record.
export CAM_SIZE=64G

# Uncomment to enable a Samba/CIFS server that makes the recordings available
# as a network share.
# This is obsolete/deprecated, as you can now access recordings via DashUSB's
# web interface.
#export SAMBA_ENABLED=true
# uncomment to enable guest access to the Samba server
#export SAMBA_GUEST=true

# Uncomment to enable DashUSB to act as a wifi access point with the given
# SSID, so you can access it while on the road. This should work on Raspberry Pi
# but may not work on other devices.
#export AP_SSID='DashUSB'
# Change this! The setup script will not accept the default 'password'
# Also note that the wifi password must be at least 8 characters.
#export AP_PASS='password'
# IP address is optional. The AP will give its clients IP addresses in the
# x.x.x.10-254 range so make sure you don't put the AP's IP address in
# that range.
#export AP_IP='192.168.66.1'

# Uncomment if you'd like to password protect the DashUSB web interface
# WARNING: Anyone on the $SSID (and $AP_SSID if configured) wifi network can
# freely interact with the DashUSB web interface if it isn't secured!
# export WEB_USERNAME='pi'
# export WEB_PASSWORD='raspberry'

# Uncomment this if you are using Raspberry Pi OS and want to set the time
# zone to something other than the default 'BST' timezone.
# If you are using Armbian then Armbian likely already set the correct time
# zone when you first set up Armbian, and uncommenting this isn't necessary.
# Can be an actual time zone, or "auto" to attempt automatic timezone detection
# export TIME_ZONE="America/Los_Angeles"

# By default there is a 20 second delay between connecting to wifi and
# starting the archiving of recorded clips. Uncomment this to change
# the duration of that delay
# export ARCHIVE_DELAY=20

# Uncomment if you want to override the default hostname of "dashusb"
# export DASHUSB_HOSTNAME=dashusb-Model3

# Push notifications consist of a title and a message.
# By default DASHUSB_HOSTNAME is used as the title, but you can
# set a custom title by setting the following variable.
# export NOTIFICATION_TITLE="DashUSB Notification"

# Uncomment if setting up Signal_cli notifications
# export SIGNAL_ENABLED=true
# export SIGNAL_URL=http://<url>:8080
# export SIGNAL_FROM_NUM=country_code_and_number_configured_with_signal
# export SIGNAL_TO_NUM=country_code_and_number_configured_with_signal

# Uncomment if setting up Pushover push notifications
# export PUSHOVER_ENABLED=true
# export PUSHOVER_USER_KEY=user_key
# export PUSHOVER_APP_KEY=app_key

# Uncomment if setting up Gotify push notifications
# export GOTIFY_ENABLED=true
# export GOTIFY_DOMAIN=https://gotify.domain.com
# export GOTIFY_APP_TOKEN=put_your_token_here
# export GOTIFY_PRIORITY=5

# Uncomment if setting up IFTTT push notifications
# export IFTTT_ENABLED=true
# export IFTTT_EVENT_NAME=put_your_event_name_here
# export IFTTT_KEY=put_your_key_here

# Uncomment if setting up Discord push notifications
# export DISCORD_ENABLED=true
# export DISCORD_WEBHOOK_URL=put_your_webhook_url_here

# Uncomment if setting up AWS SNS notifications
# export SNS_ENABLED=true
# export AWS_REGION=us-east-1
# export AWS_ACCESS_KEY_ID=put_your_accesskeyid_here
# export AWS_SECRET_ACCESS_KEY=put_your_secretkey_here
# export AWS_SNS_TOPIC_ARN=put_your_sns_topicarn_here

# Uncomment if setting up Telegram notifications
# export TELEGRAM_ENABLED=true
# export TELEGRAM_CHAT_ID=123456789
# export TELEGRAM_BOT_TOKEN=bot123456789:abcdefghijklmnopqrstuvqxyz987654321
# export TELEGRAM_SILENT_NOTIFY=false

# Uncomment if setting up Webhook notifications
# export WEBHOOK_ENABLED=true
# export WEBHOOK_URL=http://domain/path

# Uncomment if setting up Slack notifications
# export SLACK_ENABLED=true
# export SLACK_WEBHOOK_URL=http://domain/path

# Uncomment if setting up Matrix notifications
# export MATRIX_ENABLED=true
# export MATRIX_SERVER_URL=https://matrix.org
# export MATRIX_USERNAME=put_your_matrix_username_here
# export MATRIX_PASSWORD='put_your_matrix_password_here'
# export MATRIX_ROOM='put_the_matrix_target_room_id_here'

# Uncomment if setting up ntfy notifications
# export NTFY_ENABLED=true
# export NTFY_URL=https://ntfy.example.com/yourtopic
# export NTFY_TOKEN=your_token_if_needed
# export NTFY_PRIORITY=3

# Mobile App push notifications (auto-configured via pairing)
# Credentials (device_id, secret) are stored in /root/.dashusb/notification-credentials.json
# and loaded automatically by envsetup.sh — do not add them here.
# export MOBILE_PUSH_ENABLED=true

# Uncomment if setting up shell notifications.
# export NOTIFICATION_COMMAND_ENABLED=true
# export NOTIFICATION_COMMAND_START="ssh root@remote-server 'command args'"
# export NOTIFICATION_COMMAND_FINISH="ssh root@remote-server 'command args'"

# Trigger file support.
# Uncomment TRIGGER_FILE_ANY to create a trigger file in $ARCHIVE_BASE after
# every completed archive batch — useful for external post-processing tools
# that watch the archive directory.
# export TRIGGER_FILE_ANY=ARCHIVE_UPLOADED

# Temperature Monitor
#   Understanding your device’s thermal profile is crucial for maintaining
#   performance and reliability. As a point of reference, Raspberry Pi
#   Foundation states that its operating temperature range is 0°C to 85°C, and
#   the system will begin to throttle the processor when it reaches 80°C to
#   prevent damage. Anecdotally, other sub-components may become unstable at
#   lower thresholds (e.g., Wi-Fi). As a general best practice, keep the
#   temperature below 70°C. Start monitoring closely when it regularly reaches
#   above 60°C. Differences between manufacturer, model, and revisions should
#   also be considered.
#
#   Uncommenting any of the following parameters will activate DashUSB's
#   temperature monitoring, which checks temperature once a minute and retains
#   the maximum value until the device is reset or powered-off.
#
#   The following parameters determine when log entries and push messages, if
#   configured, are triggered. The fixed-interval case will only log entries,
#   but not send push message, to avoid over-saturating 
#
#   Triggers:
#   
#   Two (2) temperature threshold triggers for: WARNING and CAUTION.
#   The triggers will only fire once to cut down on spam. Only when the
#   temperatures settles 5 deg°C below the set thresholds, are they allowed to
#   re-trigger again. Caution is generally considered less severe than Warning,
#   but you have the freedom to set or unset them as you please. Set values
#   must be integers and expressed in milli-°C (e.g., 68.0°C = 68000)
#export TEMPERATURE_WARNING=68000
#export TEMPERATURE_CAUTION=55000
#
#   Fixed-interval trigger logs (no push messages) the instantaneous and maximum
#   values. The maximum value is held through the recording period and reset at
#   the conclusion of the archiving process. This trigger may be useful
#   to better understand the thermal activity throughout the day.
#   The set value must be an integer and expressed in minutes (minimum = 1).  
#export TEMPERATURE_INTERVAL=60
#
#   At the end of each archiving process, the device typically runs
#   hotter, making it an ideal time to capture temperature.
export TEMPERATURE_POSTARCHIVE=true
#
#   Travel Mode. Set to true when the Pi reaches the archive over an
#   always-on link (the vehicle's hotspot, a tethered phone, a VPN) rather
#   than home WiFi. The normal flow archives once the network appears and
#   then waits for it to disappear, which never happens on an always-on
#   link, so snapshots would stop after the first cycle. Travel Mode paces
#   the cycles on a timer instead and keeps the drive connected to the car.
#   Settings has a toggle for this; the key is read fresh every cycle.
#export TRAVEL_MODE_ENABLED=false
#
#   Seconds between Travel Mode cycles. Defaults to SNAPSHOT_INTERVAL.
#export TRAVEL_MODE_INTERVAL=900
#
#   Seconds before retrying a failed Travel Mode cycle (minimum 15).
#export TRAVEL_MODE_RETRY_INTERVAL=60
#
#   Display unit for every CPU-temperature readout — dashboard System tile,
#   push notifications, health-check API, and archive-failure log entries.
#   "C" = Celsius, "F" = Fahrenheit. Defaults to Celsius if unset. The web
#   UI's Display & Units control (Settings) writes this value; changes apply
#   live, no reboot needed.
#export TEMPERATURE_UNIT=C

# Uncomment if you want to increase the size of the root
# filesystem so there's extra space for installing additional
# software. This only works if the backing store partition hasn't
# been created yet, i.e. during early setup, and requires an extra
# reboot. Sizes can be specified as for example "500M" or "2G"
# export INCREASE_ROOT_SIZE=500M

# Uncomment if you want to use different vm/cpu parameters.
# Leave commented to use DashUSB's defaults, or set to 'default'
# to use the system defaults.
# See https://www.kernel.org/doc/Documentation/sysctl/vm.txt
# and https://www.kernel.org/doc/Documentation/cpu-freq/governors.txt
# for details.
#export DIRTY_BACKGROUND_BYTES=65536
#export DIRTY_RATIO=80
#export CPU_GOVERNOR=conservative

# GitHub source for OTA updates and their supporting scripts. REPO overrides
# the owner only (the repo name stays Dash-USB); release binaries always come
# from that repo's tagged GitHub Releases.
# export REPO=Sentry-Six

# Tracking branch for non-binary support files: the runtime-patches refresh
# and the migration tarball fallback. OTA binaries are never selected by
# branch. Advanced; leave at main unless you maintain your own branch.
# export BRANCH=main
