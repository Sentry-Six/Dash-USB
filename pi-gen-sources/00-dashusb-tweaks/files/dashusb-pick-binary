#!/bin/bash
# Select a compatible CPU-tuned binary before dashusb.service starts. Record
# the required variant in /opt/dashusb/active-variant for subsequent updates.
#
# Detection rules:
#   * armv7 userspace (32-bit Pi) → linux-armv7
#   * aarch64 with LSE atomics and AES in /proc/cpuinfo Features → linux-arm64-a76
#     ↳ Pi 5 (Cortex-A76) and compatible ARMv8.1+ boards
#   * aarch64 with CPU part 0xD08 (Cortex-A72) → linux-arm64-a72
#     ↳ Pi 4, Radxa ROCK 4C+ perf cluster
#   * other aarch64, including Cortex-A53 → linux-arm64-a53
#     ↳ Pi 3, Pi Zero 2 W, Radxa ZERO 3W, OrangePi Zero 2W
#
# Missing variants fall back through compatible binaries, then the legacy name.

set -u

INSTALL_DIR=/opt/dashusb
CURRENT_LINK="${INSTALL_DIR}/dashusb-current"
ACTIVE_FILE="${INSTALL_DIR}/active-variant"
TAG="dashusb-pick-binary"

log() { logger -t "$TAG" -- "$1" 2>/dev/null || echo "$TAG: $1" >&2; }

detect_variant() {
    # Userspace architecture determines which dynamic linker is available.
    if command -v dpkg >/dev/null 2>&1; then
        case "$(dpkg --print-architecture 2>/dev/null)" in
            armhf) echo "linux-armv7"; return ;;
            armel)
                # Unsupported armv6 still gets a chance to use an installed fallback.
                log "armel userspace detected; armv6 builds are no longer produced"
                ;;
            arm64) ;; # fall through to aarch64 sub-detection
            *) ;;    # fall through too — let uname decide
        esac
    fi

    case "$(uname -m)" in
        armv7l) echo "linux-armv7"; return ;;
        armv6l)
            log "armv6l kernel detected; armv6 builds are no longer produced"
            ;;
        aarch64) ;;
        *)
            # Preserve the legacy A72 fallback for an unknown architecture.
            echo "linux-arm64-a72"
            return
            ;;
    esac

    # The a76 build requires both ARMv8.1 LSE atomics and AES. Requiring both
    # avoids illegal crypto instructions on ARMv8.1 boards without AES.
    if grep -qE '^Features.*\batomics\b' /proc/cpuinfo \
        && grep -qE '^Features.*\baes\b' /proc/cpuinfo; then
        echo "linux-arm64-a76"
        return
    fi

    # Match any Cortex-A72 core because big.LITTLE systems list multiple parts.
    if grep -qE '^CPU part[[:space:]]*:[[:space:]]*0x[dD]08' /proc/cpuinfo; then
        echo "linux-arm64-a72"
        return
    fi

    # A53 is the conservative aarch64 default.
    echo "linux-arm64-a53"
}

DETECTED="$(detect_variant)"
PICKED="$DETECTED"
PICKED_PATH="${INSTALL_DIR}/dashusb-${PICKED}"

# Fall back through installed variants before trying the legacy filename.
if [ ! -x "$PICKED_PATH" ]; then
    log "preferred variant ${PICKED} not installed at ${PICKED_PATH}, walking fallbacks"
    for fallback in linux-arm64-a72 linux-arm64-a53 linux-armv7; do
        if [ -x "${INSTALL_DIR}/dashusb-${fallback}" ]; then
            PICKED="$fallback"
            PICKED_PATH="${INSTALL_DIR}/dashusb-${fallback}"
            log "fell back to ${fallback}"
            break
        fi
    done
fi

if [ ! -x "$PICKED_PATH" ]; then
    # Support images that predate per-CPU filenames.
    if [ -x "${INSTALL_DIR}/dashusb" ] && [ ! -L "${INSTALL_DIR}/dashusb" ]; then
        PICKED="legacy"
        PICKED_PATH="${INSTALL_DIR}/dashusb"
        log "no per-CPU binaries found, falling back to legacy ${PICKED_PATH}"
    else
        log "FATAL: no dashusb binary found under ${INSTALL_DIR}"
        exit 1
    fi
fi

# Keep the previous symlink reachable until the replacement is ready.
ln -sfn "$PICKED_PATH" "$CURRENT_LINK"

# Setup shims execute the stable PATH entry.
ln -sfn "$CURRENT_LINK" /usr/local/bin/dashusb 2>/dev/null || true

# Record the detected requirement, not a temporary fallback. Update downloads
# use this suffix; `legacy` and fallback choices may not identify the right asset.
# Failure is nonfatal because the updater can repeat detection.
if [ -n "$DETECTED" ]; then
    printf '%s\n' "$DETECTED" > "$ACTIVE_FILE" 2>/dev/null || true
fi

log "selected variant=${PICKED} (detected=${DETECTED:-unknown}) path=${PICKED_PATH}"

exit 0
