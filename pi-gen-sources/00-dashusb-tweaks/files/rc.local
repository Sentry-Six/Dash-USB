#!/bin/bash -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# Print the IP address
_IP=$(hostname -I) || true
if [ "$_IP" ]
then
  printf "My IP address is %s\n" "$_IP"
fi

if [ ! -L /dashusb ]
then
  rm -rf /dashusb
  if [ -d /boot/firmware ] && findmnt --fstab /boot/firmware &> /dev/null
  then
    ln -s /boot/firmware /dashusb
  else
    ln -s /boot /dashusb
  fi
fi

if [ -f /dashusb/run_once ]
then
  cp /dashusb/run_once /tmp/
  chmod +x /tmp/run_once
  /tmp/run_once || echo "run_once failed"
  mv /dashusb/run_once /dashusb/ran_once || true
fi

SETUP_LOGFILE=/dashusb/dashusb-setup.log

function write_all_leds {
  for led in /sys/class/leds/*
  do
    echo "$1" > "$led/$2" || true
  done &> /dev/null
}

function error_strobe() {
  modprobe ledtrig_timer || true
  write_all_leds timer trigger
  while true
  do
    write_all_leds 1 delay_on
    write_all_leds 100 delay_off
    sleep 1
    write_all_leds 0 delay_on
    sleep 1
  done
}

function setup_progress () {
  echo "$( date ) : $1" >> "$SETUP_LOGFILE" || echo "can't write to $SETUP_LOGFILE"
  echo "$1"
}

function nm_connect_wifi () {
  IFS=". " read -r start_time _ < /proc/uptime

  while ! nmcli device wifi connect "$SSID" password "$WIFIPASS" hidden yes
  do
    IFS=". " read -r now _ < /proc/uptime
    if [ $((now - start_time)) -gt 60 ]
    then
      setup_progress "failed to connect to wifi after 60 seconds, exiting"
      return 1
    fi
    setup_progress "failed to connect to wifi, retrying"
    sleep 5
  done
}

function enable_wifi () {
  setup_progress "Detecting whether to configure wifi"
  if [[ -n "$SSID" ]] && [[ -n "$WIFIPASS" ]]
  then
    if [ ! -e /dashusb/WIFI_ENABLED ]
    then
      if [ -x /root/bin/remountfs_rw ]
      then
        /root/bin/remountfs_rw
      fi
      if systemctl -q is-enabled NetworkManager.service
      then
        setup_progress "Connecting to wifi using Network Manager"
        if ! nm_connect_wifi
        then
          setup_progress "Failed to connect to wifi"
          error_strobe &
          exit 0
        fi
      else
        setup_progress "Configuring wpa_supplicant"
        cp /dashusb/wpa_supplicant.conf.sample /dashusb/wpa_supplicant.conf
        sed -i -e "s/TEMPSSID/${SSID}/g" /dashusb/wpa_supplicant.conf
        sed -i -e "s/TEMPPASS/${WIFIPASS}/g" /dashusb/wpa_supplicant.conf
        cp /dashusb/wpa_supplicant.conf /etc/wpa_supplicant/wpa_supplicant.conf
      fi

      # set the host name now if possible, so it's effective immediately after the reboot
      local old_host_name
      old_host_name=$(cat /etc/hostname)
      if [[ -n "$DASHUSB_HOSTNAME" ]] && [[ "$DASHUSB_HOSTNAME" != "$old_host_name" ]]
      then
        local new_host_name="$DASHUSB_HOSTNAME"
        echo "$new_host_name" > /etc/hostname
        if grep -q "^127\.0\.1\.1" /etc/hosts; then
          sed -i -e "s/^127\.0\.1\.1.*/127.0.1.1\t$new_host_name/" /etc/hosts
        else
          echo "127.0.1.1	$new_host_name" >> /etc/hosts
        fi
      fi

      dpkg-reconfigure -f noninteractive openssh-server
      rfkill unblock wifi &> /dev/null || true
      for i in /var/lib/systemd/rfkill/*:wlan ; do
        echo 0 > "$i"
      done
      systemctl enable ssh

      touch /dashusb/WIFI_ENABLED
      setup_progress "Rebooting..."
      exec reboot
    fi
  else
    setup_progress "skipping wifi setup because variables not specified"
  fi
}

function safesource {
  cat <<EOF > /tmp/checksetupconf
#!/bin/bash -eu
source '$1' &> /tmp/checksetupconf.out
EOF
  chmod +x /tmp/checksetupconf
  if ! /tmp/checksetupconf
  then
    setup_progress "Error in $1:"
    setup_progress "$(cat /tmp/checksetupconf.out)"
    error_strobe &
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$1"
}

if [ -e "/dashusb/dashusb.conf" ]
then
  if [ -e /root/bin/remountfs_rw ]
  then
    /root/bin/remountfs_rw
  fi
  mv /dashusb/dashusb.conf /root/
  dos2unix /root/dashusb.conf
  # The conf is used for WiFi/hostname below. Setup itself is owned
  # exclusively by the daemon (web wizard / auto-resume) — rc.local
  # never orchestrates it.
fi
if [ -e "/root/dashusb.conf" ]
then
  safesource /root/dashusb.conf
elif [ -e "/dashusb/dashusb.conf.sample" ]
then
  setup_progress "no config file found, but sample file is present."
else
  setup_progress "no config file found."
fi

# check if we previously marked wifi as enabled
enable_wifi
# Good to start setup at this point

# Setup runs exclusively through the dashusb daemon (web wizard, or its
# auto-resume of an interrupted run). The legacy bash setup orchestrator
# was removed in the Dash USB fork — one orchestrator, no races.

# we're done. If setup completed successfully, dashusb will have been
# started as a systemd service at this point

exit 0
