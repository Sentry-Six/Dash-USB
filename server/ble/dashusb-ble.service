[Unit]
Description=DashUSB BLE Peripheral
Documentation=https://github.com/Sentry-Six/Dash-USB
After=bluetooth.target bluetooth.service dbus.service
Requires=bluetooth.target dbus.service
BindsTo=bluetooth.service
ConditionPathExists=/usr/bin/python3
# Leave enough restart budget for delayed adapter enumeration or BlueZ recovery.
StartLimitBurst=20
StartLimitIntervalSec=120

[Service]
Type=simple
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
# Power every adapter so BLE_ADAPTER may select an external dongle.
ExecStartPre=-/bin/bash -c 'for hci in /sys/class/bluetooth/hci*; do [ -d "$hci" ] && /usr/bin/hciconfig $(basename "$hci") up; done'
# The daemon waits for BlueZ and sets controller flags without blocking the
# systemd boot transaction.
ExecStart=/usr/bin/python3 /root/bin/dashusb-ble.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dashusb-ble
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
