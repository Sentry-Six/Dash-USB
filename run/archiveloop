#!/bin/bash -eu

if [ "${BASH_SOURCE[0]}" != "$0" ]
then
  echo "${BASH_SOURCE[0]} must be executed, not sourced"
  return 1 # shouldn't use exit when sourced
fi

# Unload the module that was loaded by cmdline.txt

export LOG_FILE=/mutable/archiveloop.log

# If /mutable is full or the log file isn't openable, truncate it so
# archiveloop can start instead of crash-looping. The no-op redirect
# (`: >>`) opens the file in append mode without writing anything —
# we deliberately don't add a startup marker here because users saw
# the old "test" / "archiveloop starting" probe line as log noise.
# log() itself uses `|| true`, so a transient write failure later
# (e.g. disk-full mid-run) can't crash the script on its own.
if ! : >> "$LOG_FILE" 2>/dev/null; then
  : > "$LOG_FILE" 2>/dev/null || true
fi

function log () {
  echo "$( date ):" "$@" >> "$LOG_FILE" 2>/dev/null || true
  if [[ "$(stat --format="%s" "$LOG_FILE" 2>/dev/null)" -gt 1000000 ]] 2>/dev/null
  then
    local log_file2="${LOG_FILE}.2"
    tail -n 5000 "$LOG_FILE" > "${log_file2}" 2>/dev/null
    mv "$log_file2" "$LOG_FILE" 2>/dev/null || true
    log "(log truncated)"
  fi
}

function log_errors_on_exit {
  log "archiveloop exited with code $1. Recent errors follow"
  # The unit is dashusb-archive (see crates/setup install_archive_service);
  # this used to read the old teslausb unit, so on a crash the supplementary
  # journal dump was always empty.
  journalctl -n 15 -u dashusb-archive >> "$LOG_FILE" 2>/dev/null || true
  log "end of errors."
  exit "$1"
}

if [ "${FLOCKED:-}" != "$0" ]
then
  if FLOCKED="$0" flock -en -E 99 "$0" "$0" "$@" || case "$?" in
  99) echo already running
      exit 99
      ;;
  *)  log_errors_on_exit $?
      ;;
  esac
  then
    # success
    log_errors_on_exit 0
  fi
fi

export CAM_MOUNT=/mnt/cam

# read the setup variables and define other environment variables and functions
source /root/bin/envsetup.sh

# Gadget-cycle lock shared with the daemon's enable/disable handlers.
# MUST match GADGET_CYCLE_LOCK_PATH in crates/usb_gadget/src/cycle_lock.rs.
# (set -u is active: this definition was lost in the travel-mode strip
# and its absence crash-looped the service before the gadget came up.)
GADGET_CYCLE_LOCK=/tmp/sentryusb_gadget_cycle.lock

# Vehicle-profile defaults (RECORDINGS_TREE, RECORDING_ROOT,
# SNAPSHOT_INTERVAL_DEFAULT, RECORDINGS_ARCHIVE_DEFAULT, CLIP_MIN_BYTES).
# Written by the daemon at startup; user conf still wins everywhere via
# ${VAR:-$VAR_DEFAULT}.
source /root/bin/profile_env.sh 2>/dev/null || true

# led triggers may have been built as modules, so try
# to load them
if ! grep -q timer "$STATUSLED/trigger"
then
  modprobe ledtrig-timer || log "timer LED trigger unavailable"
fi
if ! grep -q heartbeat "$STATUSLED/trigger"
then
  modprobe ledtrig-heartbeat || log "heartbeat LED trigger unavailable" 
fi

if [ -z "${ARCHIVE_SERVER+x}" ]
then
  case "${ARCHIVE_SYSTEM:-none}" in
    rsync)
      export ARCHIVE_SERVER="$RSYNC_SERVER"
      ;;
    rclone)
      export ARCHIVE_SERVER="8.8.8.8"
      ;;
    none)
      export ARCHIVE_SERVER=localhost
      ;;
    *)
      log "ARCHIVE_SERVER not set"
      exit 1
      ;;
  esac
elif [ "${ARCHIVE_SYSTEM:-none}" = "cifs" ] || [ "${ARCHIVE_SYSTEM:-none}" = "nfs" ]
then
  # For CIFS and NFS
  [[ -n "${SHARE_NAME:-}" && -f /backingfiles/cam_disk.bin ]] && export ARCHIVE_MOUNT=/mnt/archive
fi

function timestamp () {
  local prefix=${1:-}
  while IFS= read -r line
  do
    echo "$(date): $prefix$line"
  done
}

function fix_errors_in_image () {
  local image="$1"
  log "Running fsck on $image..."
  if ! loopback=$(losetup_find_show -P "$image"); then
    log "ERROR: losetup failed for $image"
    return 1
  fi
  # Use -p repair arg. It works with vfat and exfat.
  /sbin/fsck "${loopback}p1" -- -p |& timestamp '| ' >> "$LOG_FILE" || echo ""
  if ! losetup -d "$loopback"; then
    log "WARNING: failed to detach loopback $loopback for $image"
  fi
  log "Finished fsck on $image."
}

function archive_is_reachable () {
  local reachable=true

  /root/bin/archive-is-reachable.sh "$ARCHIVE_SERVER" || reachable=false

  if [ "$reachable" = false ]
  then
    false
    return
  fi
  true
}

function with_gadget_lock () {
  (
    flock 209
    "$@"
  ) 209>"$GADGET_CYCLE_LOCK"
}

function connect_usb_drives_to_host() {
  with_gadget_lock connect_usb_drives_to_host_locked
}

function connect_usb_drives_to_host_locked() {
  clear_archive_status
  log "Connecting usb to host..."
  # Always ensure the USB gadget is fully torn down before touching the cam
  # disk image.  If clean_cam_mount was skipped (e.g. archive became
  # unreachable while the car drove away), the gadget is still active and
  # mounting cam_disk.bin for the sync below would give the Pi and the car
  # simultaneous access to the same block device, corrupting the filesystem
  # and causing the car to stop writing dashcam footage.
  if /root/bin/disable_gadget.sh 2>/dev/null; then
    log "Disabled stale USB gadget before sync"
    fix_errors_in_images
  fi
  if ! /root/bin/enable_gadget.sh; then
    log "ERROR: enable_gadget.sh failed (exit $?)"
  fi
  log "Connected usb to host."
  sleep 5
}

function run_archive_cycle () {
  # Wrapper around archive_clips that owns the loop-level failure state.
  ARCHIVE_CYCLE_FAILED=0
  archive_clips || ARCHIVE_CYCLE_FAILED=1
}

function wifi_cycle () {
  # This fix is only needed when ap0 exists.  ap0 shares the same physical
  # radio as wlan0 and locks it to the AP channel, preventing wlan0 from
  # scanning other channels to find the home network.  Without ap0,
  # NetworkManager handles reconnection on its own.
  if ! iw dev ap0 info &>/dev/null; then
    return
  fi

  log "Tearing down ap0 to free radio for wlan0 reconnect..."
  nmcli con down DASHUSB_AP 2>/dev/null || true
  iw dev ap0 del 2>/dev/null || true
  sleep 2

  # Disconnect and reconnect wlan0
  nmcli device disconnect wlan0 2>/dev/null || true
  sleep 2
  nmcli device connect wlan0 2>/dev/null || true

  # Wait up to 30 seconds for wlan0 to connect
  local i
  for i in $(seq 1 30); do
    local state
    state=$(nmcli -t -f DEVICE,STATE device status 2>/dev/null | grep "^wlan0:" | cut -d: -f2) || true
    if [ "${state:-}" = "connected" ]; then
      log "wlan0 reconnected after ${i}s"
      break
    fi
    sleep 1
  done

}

function wait_for_archive_to_be_reachable () {
  log "Waiting for archive to be reachable..."
  local scan_counter=0
  while true
  do
    if archive_is_reachable
    then
      log "Archive is reachable."
      break
    fi
    if [ -e /tmp/archive_is_reachable ]
    then
      log "Simulating archive is reachable"
      rm /tmp/archive_is_reachable
      break
    fi
    # WiFi recovery while waiting for home network.
    scan_counter=$((scan_counter + 1))
    if true; then
      if (( scan_counter % 30 == 0 )); then
        nmcli device wifi rescan 2>/dev/null || true
      fi
      # wifi_cycle only needed if ap0 somehow still exists
      if (( scan_counter % 300 == 0 )) && iw dev ap0 info &>/dev/null; then
        log "Archive still unreachable after ${scan_counter}s, cycling WiFi..."
        wifi_cycle
      fi
    else
      # Away Mode: skip all scanning, AP has exclusive radio access
      if (( scan_counter % 300 == 0 )); then
        log "Away Mode active, skipping WiFi scan/cycle"
      fi
    fi
    sleep 1
  done
}

function retry () {
  local attempts=0
  while true
  do
    if "$@"
    then
      true
      return
    fi
    if [ "$attempts" -ge 10 ]
    then
      log "Attempts exhausted."
      false
      return
    fi
    log "Sleeping before retry ..."
    /bin/sleep 1
    attempts=$((attempts + 1))
    log "Retrying ($attempts) '$*' ..."
  done
  false
  return
}

function ensure_mountpoint_is_mounted () {
  local mount_point="$1"

  if findmnt --mountpoint "$mount_point" > /dev/null
  then
    log "$mount_point is already mounted."
  else
    if timeout 10 mount "$mount_point" >> "$LOG_FILE" 2>&1
    then
      log "Mounted $mount_point."
    else
      log "Failed to mount $mount_point."
      return 1
    fi
  fi
}

function ensure_mountpoint_is_mounted_with_retry () {
  retry ensure_mountpoint_is_mounted "$1"
}

function ensure_cam_file_is_mounted () {
  log "Ensuring cam file is mounted..."
  disconnect_usb_drives_from_host
  ensure_mountpoint_is_mounted_with_retry "$CAM_MOUNT"
  log "Ensured cam file is mounted."
}

function unmount_mount_point () {
  local mount_point="$1"
  log "Unmounting $mount_point..."
  if umount "$mount_point" >> "$LOG_FILE" 2>&1
  then
    log "Unmounted $mount_point."
  else
    log "Failed to unmount $mount_point, trying lazy unmount."
    if umount -l "$mount_point" >> "$LOG_FILE" 2>&1
    then
      log "lazily unmounted $mount_point"
    else
      log "lazy unmount failed"
    fi
  fi
}

function unmount_cam_file () {
  unmount_mount_point "$CAM_MOUNT"
}

function wait_for_archive_to_be_unreachable () {
  log "Waiting for archive to be unreachable..."
  while true
    do
      if ! retry archive_is_reachable
      then
        log "Archive is unreachable."
        break
      fi
      if [ -e /tmp/archive_is_unreachable ]
      then
        log "Simulating archive being unreachable."
        rm /tmp/archive_is_unreachable
        break
      fi
      sleep 1
  done
}

function usb_gadget_is_active () {
  local lunfile=/sys/kernel/config/usb_gadget/dashusb/configs/c.1/mass_storage.0/lun.0/file
  [ -n "$(cat /sys/kernel/config/usb_gadget/dashusb/UDC 2>/dev/null)" ] &&
    [ -e "$lunfile" ] &&
    [ -n "$(cat "$lunfile")" ]
}

function check_if_usb_gadget_is_mounted () {
  if usb_gadget_is_active
  then
    return
  fi

  log "USB Gadget not mounted. Fixing files and remounting..."
  disconnect_usb_drives_from_host
  connect_usb_drives_to_host
}

function trim_free_space() {
  local mount_point="$1"

  # Make sure the partition is mounted.
  if found=$(findmnt -n --mountpoint "$mount_point")
  then
    loop=$(echo "$found" | awk '{print $2}')
    image=$(losetup -l -n --output=BACK-FILE "$loop")
    log "Trimming free space in $mount_point, which has $(filefrag "$image" | awk '{print $2}') extents"
    if fstrim "$mount_point" >> "$LOG_FILE" 2>&1
    then
      log "Trim complete, image now has $(filefrag "$image" | awk '{print $2}') extents"
    else
      log "Trimming free space in $mount_point failed."
    fi
  else
    log "Could not trim free space in $mount_point. Not Mounted."
  fi
}

function fix_errors_in_images () {
  for i in cam
  do
    img="/backingfiles/${i}_disk.bin"
    if [ -e "$img" ]
    then
      fix_errors_in_image "$img"
    fi
  done
}

function disconnect_usb_drives_from_host () {
  with_gadget_lock disconnect_usb_drives_from_host_locked
}

function disconnect_usb_drives_from_host_locked () {
  log "Disconnecting usb from host..."
  if /root/bin/disable_gadget.sh
  then
    fix_errors_in_images
  else
    log "ERROR: disable_gadget.sh failed (exit $?), skipping fsck"
  fi
  log "Disconnected usb from host."
}

function convert_seconds_to_nice_time () {
  local -r h=$(($1/3600))
  local -r m=$((($1%3600)/60))
  local -r s=$(($1%60))

  if [ $h -gt 0 ]
  then
    printf "%dh%dm%ds" $h $m $s
  elif [ $m -gt 0 ]
  then
    printf "%dm%ds" $m $s
  else
    printf "%ds" $s
  fi
}

function filterfile {
  if [ -x /root/bin/archive-filter ]
  then
    /root/bin/archive-filter "$1"
  fi
}

function sortfile {
  touch "$1"
  sort "$1" > /tmp/sort_tmp.$$
  mv /tmp/sort_tmp.$$ "$1"
}

function prunefile {
  sortfile "$1"
  sortfile "$2"
  comm -2 -3 "$1" "$2" > /tmp/prune_tmp.$$
  mv /tmp/prune_tmp.$$ "$1"
}

function intersect {
  sortfile "$1"
  sortfile "$2"
  comm -1 -2 "$1" "$2" > /tmp/prune_tmp.$$
  mv /tmp/prune_tmp.$$ "$1"
}

function write_archive_status () {
  echo "$1" > /tmp/archive_status.json.tmp
  mv /tmp/archive_status.json.tmp /tmp/archive_status.json
}

function clear_archive_status () {
  rm -f /tmp/archive_status.json /tmp/archive_status.json.tmp
}

function archive_progress_monitor () {
  local total="$1"
  local listfile="$2"
  local overlay="$3"
  local push_counter=0
  local start_time
  start_time=$(date +%s)

  while true; do
    sleep 5
    local done=0
    while IFS= read -r line; do
      [ -L "$overlay/$line" ] || done=$((done + 1))
    done < "$listfile"
    write_archive_status "{\"phase\":\"archiving\",\"current\":$done,\"total\":$total}"

    # Mirror progress to /mutable so a mid-batch reboot leaves a record the next
    # archiveloop run can surface in its start notification. Atomic write.
    echo "{\"phase\":\"archiving\",\"current\":$done,\"total\":$total}" > /mutable/archive_in_progress.json.tmp \
      && mv /mutable/archive_in_progress.json.tmp /mutable/archive_in_progress.json

    # Send APNs Live Activity update every ~30s (6 × 5s)
    push_counter=$((push_counter + 1))
    if [ $((push_counter % 6)) -eq 0 ]; then
      local eta=0
      local elapsed=$(( $(date +%s) - start_time ))
      if [ $done -gt 0 ] && [ $elapsed -gt 5 ]; then
        eta=$(( (total - done) * elapsed / done ))
      fi
      /root/bin/send-live-activity update archiving "$done" "$total" "$eta" || true
    fi
  done
}

function clean_cam_mount {

  local mode="${1:-}"

  if [ "$mode" = "freespace" ]
  then
    if [ -e /tmp/last_clean_time ]
    then
      read -r -d . last < /tmp/last_clean_time
      read -r -d . now < /proc/uptime
      if (( (now - last) < 300 ))
      then
        log "skipping cleaning cam mount"
        return
      fi
    fi
    cat /proc/uptime > /tmp/last_clean_time
  fi

  log "cleaning cam mount"
  ensure_cam_file_is_mounted

  # Delete the files that fsck "recovered". These are generally files
  # that were deleted previously by the car or teslausb
  find "${CAM_MOUNT}" \( \( -type f -name FSCK\*.REC \) -o \( -type f -name "*~[0-9].MP4" \) \) -print0 | xargs -0 rm -rf

  # Delete short recordings
  (cd "${CAM_MOUNT}"; find . -type f -name \*.mp4 -size -100000c -printf '%P\n' ) | xargs rm -rf

  if [ "$mode" = "freespace" ]
  then
    # Remove files, oldest first, until the car's available-space check
    # is comfortably satisfied. GM refuses to record below 32 GB free;
    # the floor comes from the vehicle profile via profile_env.sh
    # (CAM_MIN_FREE_BYTES, default 32 GiB).
 
    (cd "${CAM_MOUNT}"; find . -type f -a -path "./${RECORDING_ROOT:-}*" -printf '%P\0') > /tmp/rmcandidates.txt
    if [ -s /tmp/rmcandidates.txt ]
    then
      (cd "${CAM_MOUNT}"; xargs -a /tmp/rmcandidates.txt -0 ls -cr1) > /tmp/rmcandidatesbytime.txt
    else
      true > /tmp/rmcandidatesbytime.txt
    fi
 
    local freespace
    while read -r line
    do
      freespace=$(eval "$(stat --file-system --format="echo \$((%f*%S))" "${CAM_MOUNT}/.")")
      if ((freespace > ${CAM_MIN_FREE_BYTES:-34359738368}))
      then
        break;
      fi
      rm "${CAM_MOUNT}/$line"
    done < /tmp/rmcandidatesbytime.txt
    # Clean up temp files from RAM-backed /tmp
    rm -f /tmp/rmcandidates.txt /tmp/rmcandidatesbytime.txt
  fi

  # delete directories that are now empty (never the recording root itself)
  if [ -n "${RECORDING_ROOT:-}" ] && [ -d "$CAM_MOUNT/$RECORDING_ROOT" ]; then
    find "$CAM_MOUNT/$RECORDING_ROOT" -mindepth 1 -type d -empty -delete || true
  fi

  # Trim the camera archive to reduce the number of blocks in the snapshot.
  trim_free_space "$CAM_MOUNT"

  unmount_cam_file

  log "done cleaning cam mount"
}

# On-drive directory structure (GM Surround Vision profile):
#   <RECORDING_ROOT>/            # Android/media/…/SurroundVisionRecorder
#     FRONT_YYYY_MM_DD_T_HH_MM_SS.mp4
#     LEFT_…  RIGHT_…  REAR_…    # one file per camera per 5-min segment
# The car rolling-deletes files older than its firmware window (2 h).
# Read the SoC temperature directly from the thermal zone, formatted to match the
# temperature_monitor output. Echoes nothing on devices with no thermal sensor.
# Called inline at the moment of an archive failure so the value reflects the
# temperature *before* the chip cools: overheating (WiFi drop / throttling) is a
# common cause of archive failures, and the periodic monitor only samples once a
# minute, so by the time it logs the chip has already cooled.
# Respects TEMPERATURE_UNIT (from dashusb.conf): "F" → Fahrenheit, else Celsius.
# Re-reads the key live so a settings change doesn't need a reboot; only
# this one key is parsed (never re-source the whole conf mid-flight).
function soc_temperature () {
  local zone=/sys/class/thermal/thermal_zone0/temp
  [ -e "$zone" ] || return 0
  local raw
  raw=$(cat "$zone" 2>/dev/null) || return 0
  [ -n "$raw" ] || return 0
  local unit
  unit=$(sed -n "s/^export TEMPERATURE_UNIT=[\"']\?\([CFcf]\).*/\1/p" /root/dashusb.conf 2>/dev/null | tail -1)
  unit=${unit:-${TEMPERATURE_UNIT:-C}}
  if [ "${unit^^}" = "F" ]; then
    awk -v r="$raw" 'BEGIN { printf "%.1f°F", r/1000 * 9/5 + 32 }'
  else
    awk -v r="$raw" 'BEGIN { printf "%.1f°C", r/1000 }'
  fi
}

function archive_recordings () {
  log "Checking for recordings to archive..."

  local -r overlaylower="${RECORDINGS_TREE:-/mutable/Recordings}"
  local -r overlayupper=/tmp/cam/upper
  local -r overlaywork=/tmp/cam/work
  local -r overlaymerged=/tmp/cam/merged

  rm -rf "$overlayupper" "$overlaywork" "$overlaymerged"
  mkdir -p "$overlaylower" "$overlayupper" "$overlaywork" "$overlaymerged"

  if ! mount -t overlay overlay -o "lowerdir=$overlaylower,upperdir=$overlayupper,workdir=$overlaywork" "$overlaymerged"; then
    log "ERROR: failed to mount overlay (lower=$overlaylower upper=$overlayupper merged=$overlaymerged)"
    return 1
  fi

  # Build list of the files to be archived.
  local -r reclist=/tmp/recording_files
  local -r reclist_archived=/tmp/recording_files_archived
  local -r reclist_previously_archived=/mutable/recordings_archived
  local -r ignorelist=/tmp/ignore_files

  # Everything the snapshot link farm captured is a candidate — the car
  # rolling-deletes the source, so "archive everything" IS the product.
  # ARCHIVE_RECORDINGS=false in the conf opts out (local snapshots only);
  # the default comes from the vehicle profile via profile_env.sh.
  # Find files by name only. Don't follow the symlinks yet, since that
  # would cause all snapshots to be mounted.
  if [ "${ARCHIVE_RECORDINGS:-${RECORDINGS_ARCHIVE_DEFAULT:-true}}" = "true" ]
  then
    (cd "$overlaylower"; find . -path "./Continuous/*" -type l -fprintf "$reclist" '%P\n')
  else
    true > "$reclist"
  fi

  # Copy lists of previously-archived files from /mutable
  if [ -r "${reclist_previously_archived}" ]
  then
    cp "${reclist_previously_archived}" "${reclist_archived}"
  fi

  # Remove files that no longer exist in snapshots from the
  # "previously archived" list, so the list doesn't keep growing.
  intersect "${reclist_archived}" "${reclist}"

  # Remove previously-archived files from the archive candidate list
  prunefile "${reclist}" "${reclist_archived}"

  # ${reclist} is now a list of files that haven't been archived yet.
  # Remove short recordings (.mp4 under CLIP_MIN_BYTES — truncated tails
  # from a power cut) from this list. This requires following the links
  # and looking at the files themselves. One batched `stat -L` does the
  # whole list; `-d '\n'` keeps each line one path; broken symlinks just
  # drop out (stat errors to /dev/null).
  if [ -s "${reclist}" ]
  then
    (cd "$overlaymerged"; xargs -a "${reclist}" -d '\n' stat -L --format='%s %n' 2>/dev/null) \
      | awk -v min="${CLIP_MIN_BYTES:-100000}" '$1 < min { sub(/^[0-9]+ /, ""); if (/\.mp4$/) print }' > "${ignorelist}"
  else
    true > "${ignorelist}"
  fi

  # remove the short files from the list of files to be archived
  prunefile "${reclist}" "${ignorelist}"

  # apply custom removals/additions
  filterfile "${reclist}"

  local -r total_count=$(wc -l < "$reclist")
  local -r ignore_count=$(wc -l < "$ignorelist")

  log "There are $total_count file(s) to move. $ignore_count short recording(s) will be skipped."

  local archive_success=true
  if [[ "$total_count" -gt 0 ]]
  then
    log "Starting recording archiving"
    local -r start_ts=$(date --utc --date "now" +%s)

    local message="Archiving $total_count file(s)"
    local fail_temp=""

    # If a prior archive run was interrupted (e.g. reboot), surface how many
    # files it completed before dying. The monitor persists this every 5s.
    local prior_done=0
    if [ -r /mutable/archive_in_progress.json ]; then
      prior_done=$(sed -n 's/.*"current":\([0-9]\+\).*/\1/p' /mutable/archive_in_progress.json)
      prior_done=${prior_done:-0}
    fi
    if [[ $prior_done -gt 0 ]]; then
      message+=" ($prior_done already completed from prior run)"
    fi

    message+=" starting at $(date)"
    ARCHIVE_TOTAL_COUNT=$total_count /root/bin/send-push-message "$NOTIFICATION_TITLE:" "$message" start archive_start || log "failed to send mobile app notification"
    /root/bin/send-live-activity start "$total_count" || true

    # setup trigger files
    local -r triggerdir=/tmp/triggers
    local -r triggerlist=/tmp/triggers.txt
    rm -rf "${triggerdir}"
    mkdir -p "${triggerdir}"
    true > "${triggerlist}"
    if [ -n "${TRIGGER_FILE_ANY+x}" ]
    then
      touch "${triggerdir}/${TRIGGER_FILE_ANY}"
      echo "${TRIGGER_FILE_ANY}" >> "${triggerlist}"
    fi

    write_archive_status "{\"phase\":\"archiving\",\"current\":0,\"total\":$total_count}"
    archive_progress_monitor "$total_count" "${reclist}" "$overlaymerged" &
    local progress_pid=$!

    if /root/bin/archive-clips.sh "$overlaymerged" "${reclist}" "${triggerdir}" "${triggerlist}"
    then
      message="Archiving completed successfully. "
    else
      local arc_exit=$?
      message="Error during archiving. "
      archive_success=false
      log "ERROR: archive-clips.sh failed with exit code $arc_exit"
      # Capture SoC temperature immediately, before the chip cools, to help
      # diagnose overheating-related archive failures.
      fail_temp=$(soc_temperature)
      if [ -n "$fail_temp" ]; then
        log "SoC temperature at archive failure: $fail_temp"
      fi
      if [ -e /tmp/rsynclog ]; then
        log "--- rsync output ---"
        tail -20 /tmp/rsynclog >> "$LOG_FILE"
        log "--- end rsync output ---"
      fi
      if [ -e /tmp/archive-rsync-cmd.log ]; then
        log "--- rsync cmd log (last 10 lines) ---"
        tail -10 /tmp/archive-rsync-cmd.log >> "$LOG_FILE"
        log "--- end rsync cmd log ---"
      fi
    fi

    kill "$progress_pid" 2>/dev/null || true
    wait "$progress_pid" 2>/dev/null || true

    local -i files_archived=0

    while read -r line
    do
      if [[ ! -L "$overlaymerged/$line" ]]
      then
        files_archived=$((files_archived + 1))
        echo "$line" >> "${reclist_archived}"
      fi
    done < ${reclist}

    # copy the list of archived files back to /mutable if it has changed
    if ! diff -q -N "${reclist_archived}" "${reclist_previously_archived}" > /dev/null
    then
        cp "${reclist_archived}" "${reclist_previously_archived}.new"
        mv "${reclist_previously_archived}.new" "${reclist_previously_archived}"
    fi

    # Batch reached its end (success or failure) — clear the in-progress marker
    # so the next run's start notification doesn't claim a stale "prior run" count.
    rm -f /mutable/archive_in_progress.json

    message+="Archived ${files_archived} files"
    local -r end_ts=$(date --utc --date "now" +%s)
    local -r delta=$((end_ts - start_ts))
    message+=" in $(convert_seconds_to_nice_time $delta)"
    if [ "$archive_success" = "false" ] && [ -n "$fail_temp" ]; then
      message+=". SoC temp at failure: $fail_temp"
    fi
    /root/bin/send-push-message "$NOTIFICATION_TITLE:" "${message}" finish archive_complete
    /root/bin/send-live-activity end complete || true

    # Check RTC battery health (Pi 5 only) — warn on every archive if dead/missing
    if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
      rtc_year=$(cut -d- -f1 < /sys/class/rtc/rtc0/date 2>/dev/null)
      if [ -n "$rtc_year" ] && [ "$rtc_year" -lt 2024 ]; then
        /root/bin/send-push-message "$NOTIFICATION_TITLE:" \
          "RTC battery appears dead or missing. Replace the battery on the Pi 5's J5 header to maintain accurate time." \
          warning rtc_battery || true
      fi
    fi

    if [ -e /tmp/archive-error.log ]
    then
      cat /tmp/archive-error.log >> ${LOG_FILE}
      rm /tmp/archive-error.log
    fi
  fi

  # overlayfs behavior is undefined if the lower is changed while the overlay is active, so umount first
  umount "$overlaymerged"

  if archive_is_reachable
  then
    if [ "$archive_success" = "true" ]
    then
      clean_cam_mount freespace
    else
      log "Skipping cleaning step after archive error"
    fi
  else
    log "Archive not reachable, assuming user drove away, skipping cleaning step"
  fi

  # Report the real outcome so archive_clips can propagate failure to the
  # loop's retry pacing.
  [ "$archive_success" = "true" ]
}

function has_cam_disk () {
  [ -f /backingfiles/cam_disk.bin ]
}

function archive_clips () {
  log "Archiving..."

  # Track whether the clip-archiving part of this cycle succeeded.
  local clips_ok=true

  if ! /root/bin/connect-archive.sh
  then
    log "ERROR: connect-archive.sh failed (exit $?), skipping archive step."
    log "  ARCHIVE_SYSTEM=${ARCHIVE_SYSTEM:-unset} ARCHIVE_SERVER=${ARCHIVE_SERVER:-unset}"
    if [ "${ARCHIVE_SYSTEM:-}" = "cifs" ]; then
      log "  ARCHIVE_MOUNT=${ARCHIVE_MOUNT:-unset} SHARE_NAME=${SHARE_NAME:-unset}"
    fi
    return 1
  fi

  if ! has_cam_disk
  then
    log "Skipping archiving (no cam disk)"
  elif archive_recordings
  then
    log "Finished archiving."
  else
    log "Archiving failed."
    clips_ok=false
  fi

  # If the user drove away during archive, the gadget is still presented to
  # the car (clean_cam_mount was skipped inside archive_recordings). Skip
  # all post-archive cleanup — every step below cycles the USB gadget,
  # which would interrupt the car's recording.
  if ! archive_is_reachable; then
    log "Archive became unreachable during clip archiving (user likely drove away); skipping post-archive cleanup to keep USB drive stable for the car"
    touch /tmp/flag_post_archive
    clear_archive_status
    /root/bin/disconnect-archive.sh 2>> "$LOG_FILE" || true
    return 1
  fi

  touch /tmp/flag_post_archive  #Set post-archive flag for optional temperature logging
  clear_archive_status
  # Reconnect cam drive right away — the car can resume recording
  # immediately; nothing below touches the cam disk.
  connect_usb_drives_to_host
  /root/bin/send-live-activity end complete || true
  /root/bin/disconnect-archive.sh 2>> "$LOG_FILE" || true

  [ "$clips_ok" = "true" ]
}

function slowblink () {
  echo timer > "$STATUSLED/trigger" || return 0
  echo 900 > "$STATUSLED/delay_off"
  echo 100 > "$STATUSLED/delay_on"
}

function fastblink () {
  echo timer > "$STATUSLED/trigger" || return 0
  echo 150 > "$STATUSLED/delay_off"
  echo 50 > "$STATUSLED/delay_on"
}


function doubleblink () {
  echo heartbeat > "$STATUSLED/trigger" || return 0
  echo 0 > "$STATUSLED/invert"
}

# Write system time → RTC via /dev/rtc0 ioctl (Pi 5 only)
function rtc_sync_systohc () {
  [ -e /dev/rtc0 ] || return 1
  python3 -c "
import fcntl, struct, time
t = time.gmtime()
data = struct.pack('9i', t.tm_sec, t.tm_min, t.tm_hour, t.tm_mday, t.tm_mon-1, t.tm_year-1900, t.tm_wday, t.tm_yday, -1)
with open('/dev/rtc0', 'wb') as f:
    fcntl.ioctl(f.fileno(), 0x4024700a, data)
" 2>/dev/null
}

function set_time () {
  log "Trying to set time..."
  local -r uptime_start=$(awk '{print $1}' /proc/uptime)
  local -r clocktime_start=$(date +%s.%N)
  for _ in {1..5}
  do
    if ntpdig -S time.google.com || sntp -S 129.6.15.28
    # Fall back to NIST time server if DNS resolution fails (DNS over TLS & Cert is invalid because of wrong time)
    then
      local -r uptime_end=$(awk '{print $1}' /proc/uptime)
      local -r clocktime_end=$(date +%s.%N)
      log "$(awk "BEGIN {printf \"Time adjusted by %f seconds after %f seconds\", $clocktime_end-$clocktime_start, $uptime_end-$uptime_start}")"
      return
    fi
    log "sntp failed, retrying..."
    sleep 2
  done
  log "Failed to set time"
}

function timesyncloop {
  echo -n timesyncloop > /proc/self/comm
  while true
  do
    if ping -c 1 -W 3 time.google.com &>/dev/null || ping -c 1 -W 3 129.6.15.28 &>/dev/null; then
      set_time
      # Sync NTP-corrected time to RTC battery (Pi never shuts down gracefully)
      if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
        rtc_sync_systohc || true
      fi
    fi
    sleep "${TIME_SYNC_INTERVAL:-3600}"
  done
}

function snapshotloop {
  echo -n snapshotloop > /proc/self/comm
  while true
  do
    sleep "${SNAPSHOT_INTERVAL:-${SNAPSHOT_INTERVAL_DEFAULT:-900}}"
    /root/bin/waitforidle || true
    /root/bin/make_snapshot.sh
  done
}

function kmsgmirror {
  echo -n kmsgmirror > /proc/self/comm
  local out=/mutable/kernel.log
  local n=0
  {
    echo "===== boot $(date) ====="
    dmesg --time-format iso 2>/dev/null || dmesg 2>/dev/null || true
  } >> "$out" 2>/dev/null || true
  # Trim right after the boot dump too — on a reboot-heavy box with a
  # quiet kernel the follow loop below may not see enough lines to ever
  # hit its size check, and repeated boot dumps would grow unbounded.
  if [[ "$(stat --format=%s "$out" 2>/dev/null)" -gt 2000000 ]] 2>/dev/null
  then
    tail -n 8000 "$out" > "${out}.2" 2>/dev/null && mv "${out}.2" "$out" 2>/dev/null || true
  fi
  { dmesg -W --time-format iso 2>/dev/null || dmesg -w 2>/dev/null; } | while IFS= read -r line
  do
    echo "$line" >> "$out" 2>/dev/null || true
    n=$((n + 1))
    if (( n % 200 == 0 )) && [[ "$(stat --format=%s "$out" 2>/dev/null)" -gt 2000000 ]] 2>/dev/null
    then
      tail -n 8000 "$out" > "${out}.2" 2>/dev/null && mv "${out}.2" "$out" 2>/dev/null || true
    fi
  done
}

function freespacemanager {
  echo -n freespacemanager > /proc/self/comm
  # 10G
  local reserve=10737418240
  local threepctoftotalspace
  threepctoftotalspace=$(eval "$(stat --file-system --format="echo \$((%b*%S/33))" /backingfiles/cam_disk.bin)")
  reserve=$((reserve+threepctoftotalspace))

  while true
  do
    local freespace
    freespace=$(eval "$(stat --file-system --format="echo \$((%f*%S))" /backingfiles/cam_disk.bin)")
    if [ "$freespace" -lt "$reserve" ]
    then
      /root/bin/manage_free_space.sh "$reserve" || sleep 30
    fi
    sleep 30
  done
}

function logrotator {
  echo -n logrotator > /proc/self/comm
  while true
  do
    if [ -s /var/log/nginx/access.log ]
    then
      mv -f /var/log/nginx/access.log /var/log/nginx/access.log.prev || true
    fi
    if [ -s /var/log/nginx/error.log ]
    then
      mv -f /var/log/nginx/error.log /var/log/nginx/error.log.prev || true
    fi
    if [ -e /var/run/nginx.pid ]
    then
      kill -USR1 "$(cat /var/run/nginx.pid)"
    fi
    sleep 1800
  done
}

function wifichecker {
  echo -n wifichecker > /proc/self/comm
  dmesg -w | {
    while TMOUT=1 read -r line
    do
      true
    done
    wifi=working
    while read -r line
    do
      case $line in
        *"failed to enable fw supplicant")
          if [ "$wifi" = "working" ]
          then
            wifi="notworking"
          else
            log "restarting wifi because of: $line"
            modprobe -r brcmfmac cfg80211 brcmutil || true
            modprobe brcmfmac || true
            while TMOUT=1 read -r line
            do
              true
            done
            wifi="working"
          fi
          ;;
        *)
          wifi=working
          ;;
      esac
    done
  }
}

function set_sys_param() {
  local -r parampath="$1"
  local -r var="$2"
  local -r defaultval="$3"

  local -r val=${!var:-$defaultval}
  if [[ ${val} = "default" ]]
  then
    log "not setting $parampath"
  else
    echo "$val" > "$parampath" || true
  fi
}

export -f ensure_mountpoint_is_mounted
export -f retry
export -f ensure_mountpoint_is_mounted_with_retry
export -f log

echo "==============================================" >> "$LOG_FILE"
log "Starting archiveloop at $(awk '{print $1}' /proc/uptime) seconds uptime..."

# One-line boot forensics: distinguishes a car power-cut from a PMIC
# brownout or watchdog reset when reconstructing an incident later.
# power_reset is a Pi 5 PMIC flag (all zeros = clean power-on); throttled
# bit 0 = undervoltage since boot.
log "Boot reason: power_reset=$(od -An -tx1 /proc/device-tree/chosen/power/power_reset 2>/dev/null | tr -d ' \n' || true) throttled=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2 || true)"

set_sys_param /proc/sys/vm/dirty_background_bytes DIRTY_BACKGROUND_BYTES 65536
set_sys_param /proc/sys/vm/dirty_ratio DIRTY_RATIO 80
set_sys_param /sys/devices/system/cpu/cpufreq/policy0/scaling_governor CPU_GOVERNOR conservative

/root/bin/temperature_monitor &

if has_cam_disk
then
  snapshotloop &
  freespacemanager &
fi
logrotator &
wifichecker &
timesyncloop &
kmsgmirror &

fix_errors_in_images

if has_cam_disk
then
  # always remove files that fsck recoverd
  clean_cam_mount boot
fi

# Present the drive to the car BEFORE the boot snapshot. The snapshot is
# a reflink copy of the live image — safe while the car writes, exactly
# like every mid-loop snapshot — and taking it here used to cost the car
# ~50 extra seconds without a drive on every power-on.
connect_usb_drives_to_host

if has_cam_disk
then
  # Snapshot immediately — no waitforidle. While recording the car never
  # idles for the 5s gap, so waitforidle would burn its full 90s cap on
  # every boot AND widen the window in which the car can rotate away
  # clips before this snapshot captures them. A mid-write copy is fine:
  # make_snapshot fscks the copy (default mode), and a partial in-flight
  # clip was always possible across the power-loss boundary anyway.
  /root/bin/make_snapshot.sh || log "ERROR: boot make_snapshot.sh failed (exit $?)"
fi

if archive_is_reachable
then
  fastblink

  set_time

  # Seed RTC with NTP-corrected time on first boot
  if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
    rtc_sync_systohc || true
  fi

  # A large clock step can cause NetworkManager to drop the WiFi
  # connection (it thinks the DHCP lease expired). Re-verify and recover.
  if ! archive_is_reachable; then
    log "Network lost after time adjustment, waiting for recovery..."
    wait_for_archive_to_be_reachable
  fi

  run_archive_cycle

  doubleblink

  # Skip the gadget cycle if the user drove away during archive — the gadget
  # is still presented to the car and re-cycling it would interrupt recording.
  if archive_is_reachable; then
    connect_usb_drives_to_host
    wait_for_archive_to_be_unreachable
  fi
fi

while true
do
  slowblink

  wait_for_archive_to_be_reachable

  fastblink

  set_time

  # Sync NTP-corrected time to RTC battery
  if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
    rtc_sync_systohc || true
  fi

  # A large clock step can cause NetworkManager to drop the WiFi
  # connection (it thinks the DHCP lease expired). Re-verify and recover.
  if ! archive_is_reachable; then
    log "Network lost after time adjustment, waiting for recovery..."
    wait_for_archive_to_be_reachable
  fi

  sleep "${ARCHIVE_DELAY:-20}"

  # take a snapshot before archive_clips starts deleting files
  if has_cam_disk
  then
    if ! /root/bin/make_snapshot.sh; then
      log "ERROR: make_snapshot.sh failed (exit $?)"
    fi
  fi

  run_archive_cycle

  doubleblink

  # Skip the gadget cycle if the user drove away during archive — the gadget
  # is still presented to the car and re-cycling it would interrupt recording.
  if archive_is_reachable; then
    connect_usb_drives_to_host
    wait_for_archive_to_be_unreachable
  fi

  check_if_usb_gadget_is_mounted
done
